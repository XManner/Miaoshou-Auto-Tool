# Miaoshou Open API
MIAOSHOU_MS_URL=https://openapi-erp.91miaoshou.com
MIAOSHOU_ACTIVE_ACCOUNT_INDEX=1

# Selected account, kept for direct script compatibility.
MIAOSHOU_ACCOUNT=
MIAOSHOU_PASSWORD=
MIAOSHOU_APP_ID=
MIAOSHOU_APP_SECRET=

# Multiple Miaoshou accounts for the web console.
MIAOSHOU_ACCOUNT_1=
MIAOSHOU_PASSWORD_1=
MIAOSHOU_APP_ID_1=
MIAOSHOU_APP_SECRET_1=

MIAOSHOU_ACCOUNT_2=
MIAOSHOU_PASSWORD_2=
MIAOSHOU_APP_ID_2=
MIAOSHOU_APP_SECRET_2=

# AI provider: deepseek or kimi
AI_PROVIDER=deepseek

# DeepSeek text model
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

# Kimi / Moonshot, optional. Keep this separate from DeepSeek config.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_TEMPERATURE=1

# MiMo vision model, used for precise image audit and abnormal weight image checks.
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_IMAGE_MODEL=mimo-v2.5
MIMO_TEMPERATURE=1

# Workflow defaults
DEFAULT_WORKFLOW_SOURCE_SITE=PH
DEFAULT_WORKFLOW_GROUP_SITES=PH,MY,TH
TITLE_OPTIMIZE_MAX_LENGTH=180
TITLE_OPTIMIZE_MIN_LENGTH=25
SKU_WEIGHT_PADDING_GRAMS=30
MIN_FINAL_GROSS_WEIGHT_GRAMS=30
WEIGHT_1688_LOOKUP_THRESHOLD_GRAMS=5000

# Local web UI
WEB_HOST=127.0.0.1
WEB_PORT=3000

# Image cleanup
MAX_MAIN_IMAGE_COUNT=9
MAX_DESCRIPTION_IMAGE_COUNT=10
MIN_MAIN_IMAGE_COUNT=3
MIN_DETAIL_IMAGE_COUNT=5
ENABLE_LOCAL_DISCLAIMER_IMAGE_CHECK=1
LOCAL_IMAGE_POLICY_MAX_CHECK_COUNT=20

# Optional 1688 price and weight lookup
ENABLE_1688_IMAGE_SOURCE_PRICE_LOOKUP=1
ENABLE_1688_SOURCE_URL_PRICE_LOOKUP=1
ENABLE_1688_IMAGE_WEIGHT_LOOKUP=1
ENABLE_1688_SOURCE_URL_WEIGHT_LOOKUP=1
ENABLE_SOURCE_PRICE_CURRENT_FIELD_FALLBACK=0
SOURCE_PRICE_DIRECT_USE_THRESHOLD_CNY=3
SOURCE_PRICE_DIRECT_USE_MAX_CNY=100
